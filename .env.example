# Copy to .env for local CLI runs. Never commit real values.
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/abm_provider_agreement
APP_URL=https://your-service.onrender.com

# Shopify (Dev Dashboard app in the same org as the store)
SHOPIFY_SHOP=alphabiomedlabs.myshopify.com
SHOPIFY_API_KEY=replace-with-client-id
SHOPIFY_API_SECRET=replace-with-client-secret
# Optional: static Admin token instead of the client credentials grant
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Provider eligibility and conventions
PROVIDER_TAGS=wholesale
PENDING_TAG=provider-agreement-pending
# Where the GHL registration workflow stores the GHL contact id on the Shopify customer (VERIFY)
SHOPIFY_GHL_CONTACT_ID_METAFIELD=custom.ghl_contact_id

# GoHighLevel (Private Integration token for the sub-account / location)
GHL_PRIVATE_INTEGRATION_TOKEN=replace-with-pit-token
GHL_LOCATION_ID=replace-with-location-id
GHL_WEBHOOK_SECRET=replace-with-long-random-string
AGREEMENT_DOCUMENT_NAME=Alpha BioMed Provider Agreement
# Set only if live /proposals/document responses carry a template id (VERIFY)
AGREEMENT_TEMPLATE_ID=
# GHL contact custom field id holding the Shopify customer id, if the registration workflow writes one (VERIFY)
GHL_SHOPIFY_CUSTOMER_ID_FIELD_ID=
REQUIRE_SIGNED_DATE=true
GHL_RECENT_LOOKBACK_DAYS=120
GHL_REQUESTS_PER_SECOND=8
# Documents per GHL list request (lower if GHL returns 422; see npm run ghl:probe)
GHL_PAGE_SIZE=100

# Recovery for missing/expired invitations
RECOVERY_MODE=tag
RECOVERY_TAG=provider-agreement-resend
RECOVERY_COOLDOWN_HOURS=24
ONBOARDING_DRIP_DELAY_MINUTES=60
SUPPORT_EMAIL=support@alphabiomedlabs.com

# Backfill
BACKFILL_START_DATE=2020-01-01
BACKFILL_WINDOW_DAYS=31
BACKFILL_PAGE_SIZE=100

# Worker
WORKER_ENABLED=true
RECONCILE_INTERVAL_MINUTES=10
STATUS_RECHECK_SECONDS=5
